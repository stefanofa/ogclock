{
	"name": "ogclock",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cf dev",
		"build": "cf build",
		"deploy": "cf deploy",
		"check": "pnpm typecheck && pnpm lint && pnpm test",
		"typecheck": "cf workers types && tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"render": "tsx scripts/render.tsx",
		"gen:card": "tsx scripts/card.ts",
		"gen:fonts": "tsx scripts/fonts.ts",
		"gen:zones": "tsx scripts/zones.ts",
		"gen:web-fonts": "tsx scripts/web-fonts.ts",
		"gen:land": "tsx scripts/land.ts",
		"gen:metrics": "tsx scripts/metrics.tsx"
	},
	"dependencies": {
		"@resvg/resvg-wasm": "2.6.2",
		"satori": "0.32.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@cloudflare/vite-plugin": "beta",
		"@types/node": "^24.0.0",
		"cf": "^1.0.0-beta.29",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
